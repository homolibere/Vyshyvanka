@namespace Vyshyvanka.Designer.Components
@* Reusable confirmation dialog component *@

<div class="v-overlay @(IsOpen ? "v-overlay--open" : "")" @onclick="HandleOverlayClick" role="dialog" aria-modal="true" aria-labelledby="confirm-dialog-title">
    <div class="v-dialog @GetVariantClass()" @onclick:stopPropagation="true">
        <div class="dialog-header">
            @if (!string.IsNullOrEmpty(Icon))
            {
                <i class="fa-solid @Icon dialog-header-icon"></i>
            }
            <h3 id="confirm-dialog-title" class="v-dialog__title">@Title</h3>
            <button class="v-btn v-btn--icon v-btn--ghost v-btn--sm" @onclick="HandleCancel" disabled="@IsProcessing" aria-label="Close">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div class="v-dialog__body">
            @if (!string.IsNullOrEmpty(Message))
            {
                <p class="dialog-message">@Message</p>
            }

            @if (AffectedItems.Count > 0)
            {
                <div class="affected-items">
                    @if (!string.IsNullOrEmpty(AffectedItemsLabel))
                    {
                        <span class="affected-items-label">@AffectedItemsLabel</span>
                    }
                    <ul class="affected-items-list">
                        @foreach (var item in AffectedItems)
                        {
                            <li>@item</li>
                        }
                    </ul>
                </div>
            }

            @if (ChildContent is not null)
            {
                @ChildContent
            }
        </div>

        <div class="v-dialog__actions">
            <button class="v-btn v-btn--ghost" @onclick="HandleCancel" disabled="@IsProcessing">
                @CancelText
            </button>
            <button class="v-btn @GetConfirmButtonClass()" @onclick="HandleConfirm" disabled="@IsProcessing">
                @if (IsProcessing)
                {
                    <span class="v-spinner v-spinner--sm"></span>
                    <span>@ProcessingText</span>
                }
                else
                {
                    <span>@ConfirmText</span>
                }
            </button>
        </div>
    </div>
</div>
