@inherits LayoutComponentBase

<div class="v-layout">
    <header class="v-toolbar">
        <a href="/" class="v-toolbar__brand">
            <img src="images/logo-icon.svg" alt="" class="brand-icon"/>
            <span>Vyshyvanka</span>
        </a>
        <div class="v-toolbar__spacer"></div>
        <div class="toolbar-actions">
            <ThemeSelector/>
            <UserMenu/>
        </div>
    </header>
    <div class="v-layout__body">
        <main class="v-layout__content">
            @Body
        </main>
    </div>
</div>
