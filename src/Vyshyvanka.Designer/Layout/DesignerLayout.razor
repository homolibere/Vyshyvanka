@inherits LayoutComponentBase

<div class="v-designer-layout">
    <header class="v-toolbar v-toolbar--dark">
        <a href="/" class="v-toolbar__brand" title="Back to Home">
            <img src="images/logo-icon.svg" alt="" class="brand-icon"/>
        </a>
        <span class="v-toolbar__separator"></span>
        <div class="header-toolbar">
            @_toolbarContent
        </div>
        <div class="header-right">
            <ThemeSelector/>
            <UserMenu/>
        </div>
    </header>

    <CascadingValue Value="this" IsFixed="true">
        <div class="v-designer-layout__body">
            @Body
        </div>
    </CascadingValue>
</div>
