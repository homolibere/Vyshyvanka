@page "/"

<PageTitle>Vyshyvanka - Workflow Automation</PageTitle>

<div class="home-container">
    <h1>Welcome to Vyshyvanka</h1>
    <p class="lead">Build powerful workflow automations with a visual drag-and-drop interface.</p>

    <div class="home-actions">
        <a href="/designer" class="v-btn v-btn--primary v-btn--lg">
            <i class="fa-solid fa-pen-ruler v-icon"></i>
            <span>Open Designer</span>
        </a>
    </div>

    <div class="features">
        <div class="feature v-card v-card--interactive">
            <i class="feature-icon fa-solid fa-bolt"></i>
            <h3>Trigger-Based</h3>
            <p>Start workflows with webhooks, schedules, or manual triggers.</p>
        </div>
        <div class="feature v-card v-card--interactive">
            <i class="feature-icon fa-solid fa-link"></i>
            <h3>Connect Services</h3>
            <p>Integrate with APIs, databases, and external services.</p>
        </div>
        <div class="feature v-card v-card--interactive">
            <i class="feature-icon fa-solid fa-code-branch"></i>
            <h3>Logic Control</h3>
            <p>Use conditionals, loops, and merges to control flow.</p>
        </div>
    </div>
</div>
