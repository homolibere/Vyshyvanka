@page "/"
@namespace Vyshyvanka.Designer.Pages

<PageTitle>Vyshyvanka - Management</PageTitle>

<div class="management-container">
    <nav class="management-sidebar" role="navigation" aria-label="Main navigation">
        <div class="sidebar-nav">
            <div class="sidebar-nav-item @(_activeSection == ManagementSection.Workflows ? "sidebar-nav-item--active" : "")"
                 @onclick="() => SetActiveSection(ManagementSection.Workflows)"
                 role="button"
                 tabindex="0"
                 aria-current="@(_activeSection == ManagementSection.Workflows ? "page" : null)">
                <i class="fa-solid fa-diagram-project sidebar-nav-icon"></i>
                <span>Workflows</span>
            </div>
            <div class="sidebar-nav-item @(_activeSection == ManagementSection.Executions ? "sidebar-nav-item--active" : "")"
                 @onclick="() => SetActiveSection(ManagementSection.Executions)"
                 role="button"
                 tabindex="0"
                 aria-current="@(_activeSection == ManagementSection.Executions ? "page" : null)">
                <i class="fa-solid fa-clock-rotate-left sidebar-nav-icon"></i>
                <span>Executions</span>
            </div>
            <div class="sidebar-nav-item @(_activeSection == ManagementSection.Credentials ? "sidebar-nav-item--active" : "")"
                 @onclick="() => SetActiveSection(ManagementSection.Credentials)"
                 role="button"
                 tabindex="0"
                 aria-current="@(_activeSection == ManagementSection.Credentials ? "page" : null)">
                <i class="fa-solid fa-shield-halved sidebar-nav-icon"></i>
                <span>Credentials</span>
            </div>
            <div class="sidebar-nav-item @(_activeSection == ManagementSection.ApiKeys ? "sidebar-nav-item--active" : "")"
                 @onclick="() => SetActiveSection(ManagementSection.ApiKeys)"
                 role="button"
                 tabindex="0"
                 aria-current="@(_activeSection == ManagementSection.ApiKeys ? "page" : null)">
                <i class="fa-solid fa-key sidebar-nav-icon"></i>
                <span>API Keys</span>
            </div>
            <div class="sidebar-nav-item @(_activeSection == ManagementSection.Packages ? "sidebar-nav-item--active" : "")"
                 @onclick="() => SetActiveSection(ManagementSection.Packages)"
                 role="button"
                 tabindex="0"
                 aria-current="@(_activeSection == ManagementSection.Packages ? "page" : null)">
                <i class="fa-solid fa-box sidebar-nav-icon"></i>
                <span>Packages</span>
            </div>
            <div class="sidebar-nav-item @(_activeSection == ManagementSection.Teams ? "sidebar-nav-item--active" : "")"
                 @onclick="() => SetActiveSection(ManagementSection.Teams)"
                 role="button"
                 tabindex="0"
                 aria-current="@(_activeSection == ManagementSection.Teams ? "page" : null)">
                <i class="fa-solid fa-users sidebar-nav-icon"></i>
                <span>Teams</span>
            </div>
            <div class="sidebar-nav-item @(_activeSection == ManagementSection.Users ? "sidebar-nav-item--active" : "")"
                 @onclick="() => SetActiveSection(ManagementSection.Users)"
                 role="button"
                 tabindex="0"
                 aria-current="@(_activeSection == ManagementSection.Users ? "page" : null)">
                <i class="fa-solid fa-user-gear sidebar-nav-icon"></i>
                <span>Users</span>
            </div>
            <div class="sidebar-nav-item @(_activeSection == ManagementSection.AuditLogs ? "sidebar-nav-item--active" : "")"
                 @onclick="() => SetActiveSection(ManagementSection.AuditLogs)"
                 role="button"
                 tabindex="0"
                 aria-current="@(_activeSection == ManagementSection.AuditLogs ? "page" : null)">
                <i class="fa-solid fa-clipboard-list sidebar-nav-icon"></i>
                <span>Audit Logs</span>
            </div>
            <div class="sidebar-nav-item @(_activeSection == ManagementSection.Settings ? "sidebar-nav-item--active" : "")"
                 @onclick="() => SetActiveSection(ManagementSection.Settings)"
                 role="button"
                 tabindex="0"
                 aria-current="@(_activeSection == ManagementSection.Settings ? "page" : null)">
                <i class="fa-solid fa-gear sidebar-nav-icon"></i>
                <span>Settings</span>
            </div>
        </div>
    </nav>

    <div class="management-content">
        @switch (_activeSection)
        {
            case ManagementSection.Workflows:
                <WorkflowBrowser Embedded="@true" IsOpen="@true" />
                break;
            case ManagementSection.Executions:
                <ExecutionHistoryPanel ShowAll="@true" />
                break;
            case ManagementSection.Credentials:
                <CredentialManager Embedded="@true" IsOpen="@true" />
                break;
            case ManagementSection.ApiKeys:
                <ApiKeyManager />
                break;
            case ManagementSection.Packages:
                <PluginManager Embedded="@true" IsOpen="@true" />
                break;
            case ManagementSection.Teams:
                <TeamManager />
                break;
            case ManagementSection.Users:
                <UserManager />
                break;
            case ManagementSection.AuditLogs:
                <AuditLogViewer />
                break;
            case ManagementSection.Settings:
                <SettingsPanel />
                break;
        }
    </div>
</div>
